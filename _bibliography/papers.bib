@inproceedings{benseddik2026emopattlite,
  abbr={ICITA},
  bibtex_show={true},
  title={EmoPAtt-Lite: Lightweight Facial Emotion Recognition},
  author={{Ben Seddik}*†, Ismail and Adelekan*, Adebowale Emmanuel},
  booktitle={International Conference on Information Technology and Applications (ICITA)},
  editor={Ullah, A. and Anwar, S.},
  series={Lecture Notes in Networks and Systems},
  volume={1889},
  year={2026},
  publisher={Springer},
  address={Cham},
  doi={10.1007/978-3-032-21174-3_10},
  html={https://doi.org/10.1007/978-3-032-21174-3_10},
  abstract={Facial expressions are a fundamental component of human communication, conveying a wide range of emotions. However, automatic facial expression recognition (FER) in the wild remains challenging, particularly under adverse conditions. Recent advances in computer vision have demonstrated the effectiveness of deep neural networks for FER, but their deployment is often constrained by the need for substantial computational resources. To address this, we propose EmoPAtt-Lite, a compact FER model that modifies MobileNetV1 by integrating spatial adaptation and channel-aware recalibration modules. Unlike prior patch-attention methods, our model emphasizes spatial alignment (via a Spatial Transformer Network) and channel weighting (via Squeeze-and-Excitation block) to enhance lightweight FER performance. Despite its compressed size of only 1.3M parameters, EmoPAtt-Lite achieves state-of-the-art performance on the FER2013 benchmark, reaching an accuracy of 79.35\%, thus demonstrating that high recognition accuracy can be attained without heavy computational demands.},
  annotation={* Luddy School of Informatics, Computing and Engineering, Indiana University <br>† Corresponding Author},
  selected={true},
  preview={emopattlite.png}
}




@inproceedings{podsage2026,
  bibtex_show={true},
  title={PODSAGE: An Evidence-Grounded Multi-Agent Framework for Adaptive Learning Through Stories and Conversational Podcasts},
  author={{Ben seddik}, Ismail},
  booktitle={SAMYRAD},
  year={2026},
  address={Seville, Spain},
  abstract={Complex topics remain inaccessible to many nonexperts,while evidence indicates that well-designed narratives
    can improve comprehension and retention. Large language
    models create an opportunity to generate such narratives at
    scale and adapt them to individual learners. PODSAGE is a
    stateful multi-agent framework for adaptive educational stories
    and conversational podcasts. A central Orchestrator coordinates
    an Evidence-Grounding Council, evolving learner-state model,
    content generation, assessment, recommendation, and safeguards.
    The Council evaluates domain and learning-science evidence and
    adapts narrative form, difficulty, dialogue, pacing, audio delivery,
    and assessment to the learner and topic. This paper presents
    PODSAGE’s evidence-based design, architecture, and evaluation
    protocol for studying adaptive AI storytelling.},
  abbr={SAMYRAD},
  selected={true},
  preview={podsage_agent_architecture.png},
  note={Presented at SAMYRAD 2026, Seville, Spain. Accepted for publication; forthcoming in IEEE-indexed conference proceedings.}
}

@article{llmimpersonation,
  bibtex_show={true},
  abstract={This work investigates impersonation capabilities of Large Language Models (LLMs). It examines how effectively LLMs can mimic an individual’s writing style and opinions based on limited examples of their responses. Using three distinct impersonation methods—zeroshot prompting, few-shot prompting, and retrieval-augmented generation—the performance is evaluated through automated metrics and LLM-based detection. The findings reveal concerning implications for digital identity security and highlight the need for robust detection mechanisms to mitigate impersonation risks in online communications.},
  pdf={Human Impersonation Using Large Language Models.pdf},
  title={Human Impersonation Using Large Language Models},
  author={{Ben seddik}, Ismail},
  selected={false},
  preview={llm-impersonation.png},
  abbr={Preprint},
  year={2025}
}
